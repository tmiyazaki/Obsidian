# Copy to .env.local and fill in real values. Never commit secrets.

# Runtime
NODE_ENV=development

# Public site URL (used by Better Auth, OG images, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon serverless or local docker postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obsidian

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional: third-party providers (uncomment as needed)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Observability (optional)
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
